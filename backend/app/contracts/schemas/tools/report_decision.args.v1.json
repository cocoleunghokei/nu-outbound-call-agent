{
  "title": "ReportDecisionArgs",
  "type": "object",
  "required": [
    "situation",
    "action",
    "confidence",
    "reason",
    "dimensions"
  ],
  "properties": {
    "situation": {
      "type": "string",
      "maxLength": 200,
      "description": "What the other side offered or asked"
    },
    "action": {
      "title": "DecisionAction",
      "type": "string",
      "enum": [
        "accept",
        "counter",
        "decline",
        "share_field",
        "take_fallback",
        "end_call"
      ]
    },
    "confidence": {
      "title": "Confidence",
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "description": "The tier behind this call. Stored backend-only (agent_scores); never in the card or the push (DC-4, DC-5)"
    },
    "reason": {
      "type": "string",
      "maxLength": 200
    },
    "field_key": {
      "type": "string",
      "description": "For share_field: the share-freely field the agent is about to say"
    },
    "missed_preference": {
      "type": "string",
      "maxLength": 200,
      "description": "The preference the agent could not meet, shown as a flag in the live feed (DC-4 Medium). Plain language, no score."
    },
    "dimensions": {
      "title": "Dimensions",
      "type": "object",
      "required": [
        "needs_ask_first_field",
        "involves_money",
        "meets_constraints",
        "matches_fallback",
        "answerable_from_brief",
        "understood"
      ],
      "additionalProperties": false,
      "description": "The six DC-4 answers behind the confidence tier. Logged for debugging, never shown to the user.",
      "properties": {
        "needs_ask_first_field": {
          "type": "boolean"
        },
        "involves_money": {
          "type": "boolean"
        },
        "meets_constraints": {
          "type": "boolean"
        },
        "matches_fallback": {
          "type": "boolean"
        },
        "answerable_from_brief": {
          "type": "boolean"
        },
        "understood": {
          "type": "boolean"
        }
      }
    }
  }
}
