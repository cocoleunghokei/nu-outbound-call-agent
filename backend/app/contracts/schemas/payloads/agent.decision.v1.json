{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payloads/agent.decision.v1.json",
  "title": "AgentDecisionPayload",
  "type": "object",
  "required": [
    "situation",
    "action",
    "reason"
  ],
  "additionalProperties": false,
  "description": "Browser-visible. Deliberately has no confidence and no dimensions (DC-5).",
  "properties": {
    "situation": {
      "type": "string"
    },
    "action": {
      "title": "DecisionAction",
      "type": "string",
      "enum": [
        "accept",
        "counter",
        "decline",
        "share_field",
        "take_fallback",
        "end_call"
      ]
    },
    "reason": {
      "type": "string"
    },
    "field_key": {
      "type": "string"
    },
    "missed_preference": {
      "type": "string",
      "maxLength": 200,
      "description": "The preference the agent could not meet, shown as a flag in the live feed (DC-4 Medium). Plain language, no score."
    }
  }
}
