{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payloads/call.ended.v1.json",
  "title": "CallEndedPayload",
  "type": "object",
  "required": [
    "outcome",
    "ended_reason"
  ],
  "properties": {
    "outcome": {
      "title": "CallOutcome",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "booked",
        "cancelled",
        "rescheduled",
        "needs_follow_up",
        "refused_ai",
        "wrong_number",
        "failed",
        "no_answer",
        null
      ],
      "x-open-enum": true
    },
    "ended_reason": {
      "type": "string"
    }
  }
}
