# Vapi private API key
VAPI_API_KEY=
# Vapi phone number ID used as the caller
VAPI_PHONE_NUMBER_ID=
# Shared secret Vapi sends with webhooks
VAPI_WEBHOOK_SECRET=
# Public tunnel URL that reaches the local webhook server
PROBE_PUBLIC_URL=
# Comma-separated US E.164 receptionist test numbers
PROBE_RECEPTIONIST_NUMBERS=
# US E.164 number of the human operator
PROBE_OPERATOR_NUMBER=
# Optional: model name (default gpt-5.4-mini)
VAPI_MODEL=
# Optional: stop new calls once summed cost reaches this many USD (default 20)
PROBE_SPEND_CAP_USD=
