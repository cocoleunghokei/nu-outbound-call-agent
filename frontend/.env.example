# Copy to .env.local and fill in. Values are in the Supabase dashboard: Project Settings, then API.
VITE_SUPABASE_URL=https://tenmxbpwuxkicmgvmfym.supabase.co
VITE_SUPABASE_ANON_KEY=

# FastAPI backend origin, e.g. http://localhost:8000. Leave empty for demo mode:
# the pre-call flow runs on fake data and Start only logs the brief.
# API mode also needs the Supabase variables above: the browser signs in anonymously on
# first use (enable anonymous sign-ins in the Supabase project) and collects the profile
# on the first visit. No email is sent.
VITE_API_URL=

# Live-call page. With VITE_API_URL set, /live?call=<call id> follows the real call. Set
# this to fake to keep the scripted call anyway; empty or real means real.
VITE_LIVE_CALL_SOURCE=

# History screen (/history). With VITE_API_URL set it shows the signed-in user's calls from
# the backend. Set this to fake to keep the fake calls anyway; empty or real means real.
VITE_HISTORY_SOURCE=
