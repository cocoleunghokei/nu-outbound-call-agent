# Copy to .env.local and fill in. Values are in the Supabase dashboard: Project Settings, then API.
VITE_SUPABASE_URL=https://tenmxbpwuxkicmgvmfym.supabase.co
VITE_SUPABASE_ANON_KEY=

# FastAPI backend origin, e.g. http://localhost:8000. Leave empty for demo mode:
# the pre-call flow runs on fake data and Start only logs the brief.
# API mode also needs a signed-in Supabase session.
VITE_API_URL=

# Live-call page. Leave empty to play the scripted fake call. Set it to real (with
# VITE_API_URL above), then open the app with ?call=<call id> to follow a real call.
VITE_LIVE_CALL_SOURCE=
