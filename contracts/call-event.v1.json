{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "call-event.v1.json",
  "title": "CallEvent",
  "type": "object",
  "required": [
    "event_id",
    "call_id",
    "seq",
    "type",
    "occurred_at",
    "schema_version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "call_id": {
      "type": "string",
      "format": "uuid"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Gap-free per call, assigned on insert"
    },
    "type": {
      "type": "string",
      "x-open-enum": true,
      "description": "Known values are the if/then branches below. Unknown values fall through with an object payload."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "enum": [
        "vapi",
        "backend",
        "user"
      ]
    },
    "dedup_key": {
      "type": "string",
      "description": "Natural key from the source event, unique per call"
    },
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "status.changed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/status.changed.v1.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "transcript.final"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/transcript.final.v1.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ping.opened"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/ping.opened.v1.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ping.resolved"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/ping.resolved.v1.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent.decision"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/agent.decision.v1.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "field.shared"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/field.shared.v1.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "command.applied"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/command.applied.v1.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "call.ended"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/call.ended.v1.json"
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
