{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brief-rule.v1.json",
  "title": "BriefRule",
  "description": "One machine-checkable part of a constraint, preference or fallback, read from its text before the call. The backend compares the offer the agent heard against it; text it can't express stays without rules and the agent judges it. Times are the business's local time, 24-hour, inclusive.",
  "oneOf": [
    {
      "title": "DateRule",
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "description": "The day: exactly `on`, or a range from `earliest` to `latest` (inclusive). Set at least one; a rule with none counts as unknown.",
      "properties": {
        "kind": {
          "type": "string",
          "const": "date"
        },
        "on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "YYYY-MM-DD"
        },
        "earliest": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "YYYY-MM-DD, inclusive"
        },
        "latest": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "YYYY-MM-DD, inclusive"
        }
      }
    },
    {
      "title": "TimeRule",
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "description": "The start time window. \"Before 3pm\" is latest 14:59; \"morning (before noon)\" is latest 11:59. Set at least one; a rule with none counts as unknown.",
      "properties": {
        "kind": {
          "type": "string",
          "const": "time"
        },
        "earliest": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "description": "HH:MM, 24-hour, inclusive"
        },
        "latest": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "description": "HH:MM, 24-hour, inclusive"
        }
      }
    },
    {
      "title": "PartySizeRule",
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "description": "How many people: `exactly`, or `min` and/or `max`. Set at least one; a rule with none counts as unknown.",
      "properties": {
        "kind": {
          "type": "string",
          "const": "party_size"
        },
        "exactly": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      }
    },
    {
      "title": "PersonRule",
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false,
      "description": "Who the booking is with, e.g. a doctor or a stylist.",
      "properties": {
        "kind": {
          "type": "string",
          "const": "person"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      }
    }
  ]
}
