{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brief.v1.json",
  "title": "Brief",
  "type": "object",
  "additionalProperties": false,
  "description": "The reviewed brief (Lotto to Coco handoff). Field keys only, never profile values; values come from call_profile_snapshots at call start.",
  "required": [
    "goal",
    "business_name",
    "phone_e164",
    "template_key",
    "task_line",
    "task_vars",
    "constraints",
    "preferences",
    "fallbacks",
    "never_agree",
    "share_freely_keys",
    "ask_first_keys"
  ],
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "business_name": {
      "type": "string",
      "minLength": 1
    },
    "phone_e164": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{1,14}$"
    },
    "template_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_line": {
      "type": "string",
      "maxLength": 120,
      "description": "Template; {name} placeholders resolve from task_vars"
    },
    "task_vars": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "title": "TaskVarLiteral",
            "type": "object",
            "required": [
              "literal"
            ],
            "additionalProperties": false,
            "properties": {
              "literal": {
                "type": "string"
              }
            }
          },
          {
            "title": "TaskVarFieldRef",
            "type": "object",
            "required": [
              "field_ref"
            ],
            "additionalProperties": false,
            "properties": {
              "field_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "title": "BriefConstraint",
        "type": "object",
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "rules": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "$ref": "brief-rule.v1.json"
            },
            "description": "Optional. All must hold for this item to match. Absent: the agent judges the text alone."
          }
        }
      }
    },
    "preferences": {
      "type": "array",
      "items": {
        "title": "BriefPreference",
        "type": "object",
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "rules": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "$ref": "brief-rule.v1.json"
            },
            "description": "Optional. All must hold for this item to match. Absent: the agent judges the text alone."
          }
        }
      }
    },
    "fallbacks": {
      "type": "array",
      "items": {
        "title": "BriefFallback",
        "type": "object",
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "rules": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "$ref": "brief-rule.v1.json"
            },
            "description": "Optional. All must hold for this item to match. Absent: the agent judges the text alone."
          }
        }
      },
      "description": "Ranked, best first"
    },
    "never_agree": {
      "type": "array",
      "items": {
        "title": "BriefNeverAgree",
        "type": "object",
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "share_freely_keys": {
      "type": "array",
      "items": {
        "title": "ShareFreelyKey",
        "type": "string",
        "minLength": 1
      }
    },
    "ask_first_keys": {
      "type": "array",
      "items": {
        "title": "AskFirstKey",
        "type": "string",
        "minLength": 1
      }
    },
    "call_details": {
      "type": "array",
      "description": "Answers the user gave in the pre-call chat for this call's template fields with source 'call' (e.g. patient_status), in template order, so the agent can answer when asked (PC-4). Never profile values. Optional: briefs stored before it existed don't have it.",
      "items": {
        "title": "BriefCallDetail",
        "type": "object",
        "required": [
          "key",
          "question",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 64
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "The template's question, e.g. 'Are you a new or existing patient?'"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    }
  }
}
